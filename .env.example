# Agent OS 本地凭证模板。复制为 .env 后填写，不要提交实际值。
BOTS_CONFIG=config/bots.json

# 默认单 bot 配置只需这一对凭证；名称与 bots.json 中的 appIdEnv/appSecretEnv 对应。
FEISHU_DEVELOPER_APP_ID=cli_xxx
FEISHU_DEVELOPER_APP_SECRET=xxx

# 三 bot 团队额外需要以下凭证，见 config/bots.team.example.json。
# FEISHU_CEO_ASSISTANT_APP_ID=cli_xxx
# FEISHU_CEO_ASSISTANT_APP_SECRET=xxx
# FEISHU_PRODUCT_APP_ID=cli_xxx
# FEISHU_PRODUCT_APP_SECRET=xxx

# 推荐在 bots.json 中填写每台 bot 的 ownerOpenId。
# open_id 按应用隔离，同一个人在不同 bot 眼里可能有不同 ID。
# 以下值只在对应 bot 没写 ownerOpenId 时兜底；单 bot 可用，多 bot 应逐台配置。
# 未配置 allowedUserOpenIds 时，只有 ownerOpenId 可以使用；两者都没有则拒绝所有人。
OWNER_OPEN_ID=

# 仅在 bot 没写 workspace 时使用；推荐显式配置与本仓库分开的受信任项目目录。
CLI_WORKDIR=

# Claude Code / Codex 的模型和登录凭证由各自的用户级配置管理，不要写在这里。
